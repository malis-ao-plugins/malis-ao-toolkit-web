{
  "name": "malis-ao-toolkit-web",
  "version": "0.1.0",
  "private": true,
  "homepage": "./",
  "main": "electron.js",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "cross-env CI=true react-scripts test --watchAll=false",
    "eject": "react-scripts eject",
    "electron:dev": "concurrently \"cross-env BROWSER=none react-scripts start\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "react-scripts build && electron-builder",
    "mock": "node tools/mock-backends.js",
    "plugins": "react-scripts build && node tools/publish-plugins.js",
    "shot": "electron tools/screenshot.js"
  },
  "build": {
    "appId": "com.malis.aotoolkit",
    "productName": "Mali's AO Toolkit",
    "files": [
      "build/**/*",
      "electron.js",
      "preload.js"
    ],
    "extraMetadata": {
      "main": "electron.js"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "purgecss": "^8.0.0",
    "wait-on": "^8.0.3"
  }
}
